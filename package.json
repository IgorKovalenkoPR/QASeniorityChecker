{
  "name": "qa-seniority-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Self-assessment platform that estimates a QA engineer's seniority level before a formal Performance Review",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @qasc/api",
    "dev:web": "npm run dev -w @qasc/web",
    "start": "npm run build && npm run start -w @qasc/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "tsx scripts/check-bundle-leak.ts",
    "typecheck": "tsc -b --pretty && tsc --noEmit -p apps/web",
    "export:variants": "npm run export:variants -w @qasc/api -- ../../docs/variants.md"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
